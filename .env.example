# AIHub 服务端环境变量示例（复制为 .env 或在 compose 中覆盖）

# HTTP 监听地址
AIHUB_HTTP_ADDR=:8080
# 对外访问地址（用于链接与 MCP）
AIHUB_PUBLIC_BASE_URL=http://localhost:8080

# PostgreSQL
AIHUB_DATABASE_URL=postgres://aihub:aihub@localhost:5432/aihub?sslmode=disable

# MinIO / S3 兼容存储
AIHUB_MINIO_ENDPOINT=localhost:9000
AIHUB_MINIO_ACCESS_KEY=aihub
AIHUB_MINIO_SECRET_KEY=aihub-secret
AIHUB_MINIO_USE_SSL=false
AIHUB_MINIO_BUCKET=aihub

# 单管理员引导
ADMIN_USERNAME=admin
ADMIN_PASSWORD_FILE=./admin_password.txt

# 会话与登录限流
AIHUB_SESSION_TTL=24h
AIHUB_TOKEN_TTL=0
AIHUB_LOGIN_MAX_ATTEMPTS=5
AIHUB_LOGIN_WINDOW=5m

# 上传限制（MB）
AIHUB_MAX_UPLOAD_MB=100

# 模块启停（逗号分隔；留空表示全部启用）
# AIHUB_MODULES=core,prompts,skills,experts,mcp_catalog
